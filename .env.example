# Wakey environment — copy to .env and fill in. NEVER commit .env.
# All values are optional unless marked REQUIRED; defaults suit a laptop install.

# --- Required -----------------------------------------------------------------
# Encrypts stored credentials (forge keys, AI keys) — generate once, keep safe:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WAKEY_MASTER_KEY=

# --- Server (defaults shown) --------------------------------------------------
WAKEY_PORT=8477
# Public URL if the dashboard is reachable beyond localhost (reverse proxy):
WAKEY_BASE_URL=http://localhost:8477
# Secret used to verify GitHub/forge webhook signatures:
WAKEY_WEBHOOK_SECRET=
# SQLite by default; set to enable Postgres (see docs/distribution.md):
# WAKEY_DATABASE_URL=postgresql://wakey:wakey@localhost:5432/wakey

# --- AI profiles (bring your own — any provider, any mix; WF-14 §B) -----------
# Keys referenced by ai: profiles in wakey.yml. Leave empty to run without AI
# (monitoring continues; RCA/fix degrade gracefully).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local models (e.g. Ollama's OpenAI-compatible endpoint):
# WAKEY_LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
