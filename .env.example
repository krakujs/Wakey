# Wakey environment — copy to .env and fill in. NEVER commit .env.
# All values are optional unless marked REQUIRED; defaults suit a laptop install.

# --- Required -----------------------------------------------------------------
# Encrypts stored credentials (forge keys, AI keys) — generate once, keep safe:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Used for encrypted stored credentials; preserve securely across restarts.
WAKEY_MASTER_KEY=
# Compose enables local owner-only persistent key bootstrap. For managed
# production use a secret-manager supplied WAKEY_MASTER_KEY instead.
# WAKEY_AUTO_MASTER_KEY=true
# Approved HTTPS connector URL (not yet publicly deployed). Empty = BYO-App/PAT.
# WAKEY_CONNECT_URL=https://<operator-approved-connect-host>

# --- Server (defaults shown) --------------------------------------------------
WAKEY_PORT=8477
# Public URL if the dashboard is reachable beyond localhost (reverse proxy):
WAKEY_BASE_URL=http://localhost:8477
# Secret used to verify GitHub/forge webhook signatures:
WAKEY_WEBHOOK_SECRET=
# SQLite by default; PostgreSQL DSNs are also supported:
# WAKEY_DATABASE_URL=sqlite:///var/lib/wakey/wakey.db
WAKEY_LOG_LEVEL=INFO
# Durable delivery workers (1-16):
# WAKEY_WORKER_COUNT=2
# Event/delivery retention window in days:
# WAKEY_RETENTION_DAYS=30
# Ingest wakey's own errors (OPS-4 self-watch):
# WAKEY_SELF_WATCH=false
# Logins allowed to direct @wakey commands via webhooks (deny-by-default,
# WF-07 §3) until installation-permission checks land:
# WAKEY_AUTHORIZED_USERS=alice,bob

# --- GitHub (live forge; empty = console dev sink) -----------------------------
# PAT or App installation token. Tickets are created in WAKEY_GITHUB_REPO.
WAKEY_GITHUB_TOKEN=
WAKEY_GITHUB_REPO=owner/name
# Hard write-allowlist (comma-separated). Strongly recommended; mandatory soon:
# WAKEY_ALLOWED_REPOS=owner/name,owner/other
# WAKEY_GITHUB_API_BASE=https://api.github.com

# --- AI (Anthropic-compatible endpoint; empty = heuristic RCA only) ------------
WAKEY_LLM_BASE_URL=
WAKEY_LLM_API_KEY=
WAKEY_LLM_MODEL=glm-4.5-air
# Hard RCA dispatch ceilings (calls and worst-case reserved tokens per hour):
# WAKEY_RCA_MAX_PER_HOUR=30
# WAKEY_RCA_MAX_TOKENS_PER_HOUR=30000
# Local models via an OpenAI-to-Anthropic gateway, or Ollama + gateway:
# WAKEY_LLM_BASE_URL=http://host.docker.internal:8480

# --- Isolated fix execution ---------------------------------------------------
# Required for live fixes. Pre-build a trusted image with the service's test
# dependencies; pin its digest in production. Images are NEVER auto-pulled.
# The executor host must provide Docker and the local workspace to its daemon.
# No Docker/image => fix fails closed; never falls back to host subprocesses.
# Cloud Run and other runtime-less hosts: point WAKEY_SANDBOX_EXECUTOR_URL at a
# dedicated `wakey-executor` service (see deploy/compose.fixer.yml) instead.
# WAKEY_SANDBOX_IMAGE=trusted-test-image@sha256:<digest>
# WAKEY_SANDBOX_EXECUTOR_URL=https://fixer.internal:8490
# WAKEY_SANDBOX_EXECUTOR_TOKEN=generate-a-long-random-token
