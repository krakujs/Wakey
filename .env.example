# Wakey environment — copy to .env and fill in. NEVER commit .env.
# All values are optional unless marked REQUIRED; defaults suit a laptop install.

# --- Required -----------------------------------------------------------------
# Encrypts stored credentials (forge keys, AI keys) — generate once, keep safe:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# NOTE: accepted but unused until credential encryption lands (E10, R-10).
WAKEY_MASTER_KEY=

# --- Server (defaults shown) --------------------------------------------------
WAKEY_PORT=8477
# Public URL if the dashboard is reachable beyond localhost (reverse proxy):
WAKEY_BASE_URL=http://localhost:8477
# Secret used to verify GitHub/forge webhook signatures:
WAKEY_WEBHOOK_SECRET=
# SQLite by default; other backends are rejected until implemented (OPS-5):
# WAKEY_DATABASE_URL=sqlite:///var/lib/wakey/wakey.db
WAKEY_LOG_LEVEL=INFO
# Durable delivery workers (1-16):
# WAKEY_WORKER_COUNT=2
# Event/delivery retention window in days:
# WAKEY_RETENTION_DAYS=30
# Ingest wakey's own errors (OPS-4 self-watch):
# WAKEY_SELF_WATCH=false
# Logins allowed to direct @wakey commands via webhooks (deny-by-default,
# WF-07 §3) until installation-permission checks land:
# WAKEY_AUTHORIZED_USERS=alice,bob

# --- GitHub (live forge; empty = console dev sink) -----------------------------
# PAT or App installation token. Tickets are created in WAKEY_GITHUB_REPO.
WAKEY_GITHUB_TOKEN=
WAKEY_GITHUB_REPO=owner/name
# Hard write-allowlist (comma-separated). Strongly recommended; mandatory soon:
# WAKEY_ALLOWED_REPOS=owner/name,owner/other
# WAKEY_GITHUB_API_BASE=https://api.github.com

# --- AI (Anthropic-compatible endpoint; empty = heuristic RCA only) ------------
WAKEY_LLM_BASE_URL=
WAKEY_LLM_API_KEY=
WAKEY_LLM_MODEL=glm-4.5-air
# Local models via an OpenAI-to-Anthropic gateway, or Ollama + gateway:
# WAKEY_LLM_BASE_URL=http://host.docker.internal:8480
